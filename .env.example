# Sanity public configuration (no read token is required for a public dataset)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-18

# WhatsApp Business number as digits with its country code. Leave empty to disable checkout.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Production HTTPS origin, without a trailing path. Used for metadata and Brevo confirmation redirects.
NEXT_PUBLIC_SITE_URL=https://weartimeless.xyz
# Optional override for the public support address (also review Global Settings in Sanity).
NEXT_PUBLIC_SUPPORT_EMAIL=

# SERVER ONLY: never prefix these with NEXT_PUBLIC_ or commit their values.
BREVO_API_KEY=
BREVO_LIST_ID=
# Active transactional double-opt-in template containing the {{ params.DOIurl }} link.
BREVO_DOI_TEMPLATE_ID=

# Optional GA4. Disabled unless explicitly enabled; tags wait for visitor consent.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set false on non-Vercel staging environments; Vercel previews are excluded automatically.
SITE_INDEXABLE=true

# Optional Sentry error-only monitoring; no session replay or performance tracing.
# Add the server DSN and the public browser DSN for your project; leave blank to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_RELEASE=
